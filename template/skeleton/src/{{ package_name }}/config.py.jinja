"""Runtime configuration loaded from the process environment."""

import os
from dataclasses import dataclass
from pathlib import Path

from dotenv import load_dotenv


PREFIX = "{{ package_name | upper }}"
RUNTIME_ROOT = Path(__file__).resolve().parent.parent
load_dotenv(RUNTIME_ROOT / ".env")


@dataclass(frozen=True)
class Settings:
    host: str
    port: int
    log_level: str

    @classmethod
    def from_environment(cls) -> "Settings":
        port = int(os.getenv(f"{PREFIX}_PORT", "8000"))
        if not 1 <= port <= 65535:
            raise ValueError(f"{PREFIX}_PORT must be between 1 and 65535.")
        return cls(
            host=os.getenv(f"{PREFIX}_HOST", "127.0.0.1"),
            port=port,
            log_level=os.getenv(f"{PREFIX}_LOG_LEVEL", "INFO").lower(),
        )


settings = Settings.from_environment()
