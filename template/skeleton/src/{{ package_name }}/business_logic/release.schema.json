{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:miniagent:schema:release-manifest:v1",
  "title": "MiniAgent Release Manifest",
  "description": "A hash-bound, evaluated application release ready for standalone deployment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "application_id",
    "version",
    "created_at",
    "source_revision",
    "policy",
    "runtime",
    "artifacts",
    "evaluation",
    "provenance",
    "verification",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "miniagent.release-manifest.v1"
    },
    "release_id": {
      "$ref": "#/$defs/identifier"
    },
    "application_id": {
      "$ref": "#/$defs/identifier"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_revision": {
      "type": "string",
      "minLength": 7
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_revision", "format", "action_parser", "runtime", "weights"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "model_revision": {"type": "string", "minLength": 1},
        "format": {"enum": ["safetensors", "onnx", "gguf"]},
        "action_parser": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "artifact"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "artifact": {"$ref": "#/$defs/artifact"}
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entrypoint", "artifact"],
          "properties": {
            "entrypoint": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
            },
            "artifact": {"$ref": "#/$defs/artifact"}
          }
        },
        "weights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "artifact"],
            "properties": {
              "role": {"enum": ["base", "adapter", "merged", "tokenizer", "chat_template"]},
              "artifact": {"$ref": "#/$defs/artifact"}
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "python", "entrypoints", "environment", "bundle"],
      "properties": {
        "package": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "entrypoints": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"enum": ["api", "cli", "worker"]},
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "healthcheck": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "required", "secret"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
              "description": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"},
              "secret": {"type": "boolean"}
            }
          }
        },
        "bundle": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "path", "sha256", "bytes"],
            "properties": {
              "role": {
                "enum": [
                  "application_contract",
                  "policy",
                  "workflow",
                  "tool_contract",
                  "knowledge_base",
                  "configuration",
                  "runtime_asset",
                  "runtime_code",
                  "runtime_contract",
                  "dependency",
                  "test"
                ]
              },
              "path": {"$ref": "#/$defs/relative_path"},
              "sha256": {"$ref": "#/$defs/sha256"},
              "bytes": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "artifact"],
        "properties": {
          "role": {
            "enum": [
              "application_contract",
              "workflow",
              "tool_contract",
              "knowledge_base",
              "configuration",
              "runtime_asset"
            ]
          },
          "artifact": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_id", "manifest", "leaderboard_entry", "status"],
      "properties": {
        "evaluation_id": {"$ref": "#/$defs/identifier"},
        "manifest": {"$ref": "#/$defs/artifact"},
        "leaderboard_entry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evaluation_id",
            "created_at",
            "candidate_id",
            "candidate_version",
            "comparability_key",
            "status",
            "metrics",
            "manifest"
          ],
          "properties": {
            "evaluation_id": {"$ref": "#/$defs/identifier"},
            "created_at": {"type": "string", "format": "date-time"},
            "candidate_id": {"$ref": "#/$defs/identifier"},
            "candidate_version": {"type": "string", "minLength": 1},
            "comparability_key": {"$ref": "#/$defs/sha256"},
            "status": {"enum": ["passed", "failed"]},
            "metrics": {"type": "array", "minItems": 1},
            "manifest": {"$ref": "#/$defs/artifact"}
          }
        },
        "status": {"const": "passed"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "workflows", "tools", "dataset", "training"],
      "properties": {
        "application": {"$ref": "#/$defs/artifact"},
        "workflows": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "dataset": {"$ref": "#/$defs/artifact"},
        "training": {"$ref": "#/$defs/artifact"}
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "evidence"],
        "properties": {
          "name": {"$ref": "#/$defs/identifier"},
          "status": {"const": "passed"},
          "evidence": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "status": {
      "const": "ready"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
