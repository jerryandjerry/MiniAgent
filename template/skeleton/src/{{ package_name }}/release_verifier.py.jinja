"""Verify the promoted application and release before readiness."""

import hashlib
import json
import os
from pathlib import Path
import sys
from typing import Any, Dict, Iterable, Optional, Tuple

from jsonschema import Draft202012Validator, FormatChecker
from packaging.specifiers import InvalidSpecifier, SpecifierSet
from packaging.version import Version


PACKAGE_ROOT = Path(__file__).absolute().parent
MANIFEST_PATH = PACKAGE_ROOT / "deployment_manifest.json"
APPLICATION_PATH = PACKAGE_ROOT / "business_logic" / "application.json"
APPLICATION_SCHEMA_PATH = PACKAGE_ROOT / "business_logic" / "application.schema.json"
RELEASE_SCHEMA_PATH = PACKAGE_ROOT / "business_logic" / "release.schema.json"
CONFIGURED_PACKAGE = {{ package_name | to_json }}


class ReleaseVerificationError(ValueError):
    """Raised when the packaged runtime differs from its approved release."""


def _load_json(path: Path, label: str) -> Dict[str, Any]:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ReleaseVerificationError(f"Load the packaged {label}: {exc}") from exc
    if not isinstance(payload, dict):
        raise ReleaseVerificationError(f"The packaged {label} must be a JSON object.")
    return payload


def _validate_schema(
    payload: Dict[str, Any], schema: Dict[str, Any], label: str
) -> None:
    errors = sorted(
        Draft202012Validator(schema, format_checker=FormatChecker()).iter_errors(
            payload
        ),
        key=lambda error: tuple(str(part) for part in error.path),
    )
    if errors:
        error = errors[0]
        location = ".".join(str(part) for part in error.absolute_path) or "root"
        raise ReleaseVerificationError(
            f"The packaged {label} violates its schema at {location}: {error.message}"
        )


def _inside(path: Path, root: Path) -> bool:
    try:
        path.resolve().relative_to(root.resolve())
        return True
    except ValueError:
        return False


def _require_regular_ancestry(path: Path, root: Path) -> None:
    root_path = root.absolute()
    path_value = path.absolute()
    try:
        relative = path_value.relative_to(root_path)
    except ValueError as exc:
        raise ReleaseVerificationError("Keep the runtime package inside src/.") from exc
    cursor = root_path
    if cursor.is_symlink():
        raise ReleaseVerificationError("The runtime source ancestry requires directories.")
    for part in relative.parts:
        cursor = cursor / part
        if cursor.is_symlink():
            raise ReleaseVerificationError("The runtime source ancestry requires directories.")


def _files(path: Path) -> Iterable[Path]:
    entries = sorted(path.rglob("*"))
    symlinks = [item for item in entries if item.is_symlink()]
    if symlinks:
        raise ReleaseVerificationError(
            f"Release bundles contain regular files only: {symlinks[0]}."
        )
    return [item for item in entries if item.is_file()]


def _file_hash(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def _hash(path: Path) -> str:
    if path.is_symlink():
        raise ReleaseVerificationError(
            f"Release artifacts must be regular files or directories: {path}."
        )
    if path.is_file():
        return _file_hash(path)
    if path.is_dir():
        files = list(_files(path))
        if not files:
            raise ReleaseVerificationError(f"Release directory contains no files: {path}.")
        digest = hashlib.sha256()
        for item in files:
            relative = item.relative_to(path).as_posix().encode("utf-8")
            digest.update(len(relative).to_bytes(8, "big"))
            digest.update(relative)
            digest.update(bytes.fromhex(_file_hash(item)))
        return digest.hexdigest()
    raise ReleaseVerificationError(f"Release artifact is unavailable: {path}.")


def _bytes(path: Path) -> int:
    if path.is_file():
        return path.stat().st_size
    return sum(item.stat().st_size for item in _files(path))


def _signature(record: Dict[str, Any]) -> Tuple[str, int]:
    return str(record["sha256"]), int(record["bytes"])


def _matching_records(
    records: Iterable[Dict[str, Any]], expected: Dict[str, Any]
) -> list[Dict[str, Any]]:
    signature = _signature(expected)
    return [record for record in records if _signature(record) == signature]


def verify_release(package_root: Optional[Path] = None) -> Dict[str, Any]:
    requested_root = Path(package_root) if package_root is not None else PACKAGE_ROOT
    requested_source = requested_root.absolute().parent
    _require_regular_ancestry(requested_source, requested_source.parent)
    _require_regular_ancestry(requested_root, requested_source.parent)
    root = requested_root.resolve()
    source_root = root.parent
    manifest_path = root / "deployment_manifest.json"
    application_path = root / "business_logic" / "application.json"
    application_schema_path = root / "business_logic" / "application.schema.json"
    release_schema_path = root / "business_logic" / "release.schema.json"

    application = _load_json(application_path, "application contract")
    application_schema = _load_json(application_schema_path, "application schema")
    _validate_schema(application, application_schema, "application contract")
    if application["status"] != "approved":
        raise ReleaseVerificationError(
            "An approved packaged application contract is required."
        )
    if application["package"] != CONFIGURED_PACKAGE:
        raise ReleaseVerificationError(
            "The application contract package differs from the configured package."
        )

    manifest = _load_json(manifest_path, "release manifest")
    release_schema = _load_json(release_schema_path, "release schema")
    _validate_schema(manifest, release_schema, "release manifest")
    if manifest["status"] != "ready":
        raise ReleaseVerificationError("A promoted release with ready status is required.")
    if manifest["application_id"] != application["application_id"]:
        raise ReleaseVerificationError(
            "The release application_id differs from the application contract."
        )
    if manifest["runtime"]["package"] != CONFIGURED_PACKAGE:
        raise ReleaseVerificationError(
            "The release runtime package differs from the configured package."
        )
    try:
        supported_python = SpecifierSet(manifest["runtime"]["python"])
    except InvalidSpecifier as exc:
        raise ReleaseVerificationError(
            "Set runtime.python to a valid Python version constraint."
        ) from exc
    running_python = Version(
        f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}"
    )
    if running_python not in supported_python:
        raise ReleaseVerificationError(
            f"Python {running_python} is outside runtime.python {supported_python}."
        )
    python_version_path = source_root / ".python-version"
    declared_python = python_version_path.read_text(encoding="utf-8").strip()
    if not declared_python.startswith(
        f"{sys.version_info.major}.{sys.version_info.minor}"
    ):
        raise ReleaseVerificationError(
            "The active Python version differs from src/.python-version."
        )
    missing_environment = [
        item["name"]
        for item in manifest["runtime"]["environment"]
        if item["required"] and not os.environ.get(item["name"])
    ]
    if missing_environment:
        raise ReleaseVerificationError(
            "Required runtime environment is missing: "
            + ", ".join(sorted(missing_environment))
            + "."
        )

    bundle = manifest["runtime"]["bundle"]
    paths = set()
    by_role: Dict[str, list[Dict[str, Any]]] = {}
    for record in bundle:
        relative = record["path"]
        path = source_root / relative
        if not _inside(path, source_root) or path == source_root:
            raise ReleaseVerificationError(f"Release path leaves src/: {relative}.")
        if not path.is_file():
            raise ReleaseVerificationError(
                f"Runtime bundle entries must identify files: {relative}."
            )
        if relative in paths:
            raise ReleaseVerificationError(
                f"Release path appears more than once: {relative}."
            )
        paths.add(relative)
        if _hash(path) != record["sha256"]:
            raise ReleaseVerificationError(f"Release hash differs for {relative}.")
        if _bytes(path) != record["bytes"]:
            raise ReleaseVerificationError(f"Release byte count differs for {relative}.")
        by_role.setdefault(record["role"], []).append(record)

    ignored_parts = {
        ".git",
        ".mypy_cache",
        ".pytest_cache",
        ".ruff_cache",
        ".venv",
        "__pycache__",
        "build",
        "dist",
    }
    required_paths = {
        "pyproject.toml",
        "uv.lock",
        ".python-version",
        "{{ package_name }}/agent.py",
        "{{ package_name }}/api.py",
        "{{ package_name }}/cli.py",
        "{{ package_name }}/release_verifier.py",
        "{{ package_name }}/business_logic/application.json",
    }
    if not required_paths.issubset(paths):
        raise ReleaseVerificationError(
            "The runtime bundle requires code, dependency locks, and the application contract."
        )
    symlinks = [
        path
        for path in source_root.rglob("*")
        if path.is_symlink()
        and not any(part in ignored_parts for part in path.relative_to(source_root).parts)
    ]
    if symlinks:
        raise ReleaseVerificationError("The runtime source tree requires regular files.")
    manifest_relative = manifest_path.relative_to(source_root).as_posix()
    observed_paths = {
        path.relative_to(source_root).as_posix()
        for path in source_root.rglob("*")
        if path.is_file()
        and not path.is_symlink()
        and path.name != ".env"
        and path.relative_to(source_root).as_posix() != manifest_relative
        and not any(
            part in ignored_parts for part in path.relative_to(source_root).parts
        )
    }
    if paths != observed_paths:
        missing = sorted(observed_paths.difference(paths))
        extra = sorted(paths.difference(observed_paths))
        raise ReleaseVerificationError(
            f"Runtime bundle must inventory the complete src tree; missing={missing}, extra={extra}."
        )

    application_records = by_role.get("application_contract", [])
    if len(application_records) != 1:
        raise ReleaseVerificationError(
            "The runtime bundle requires exactly one application contract."
        )
    application_record = application_records[0]
    if application_record["path"] != "{{ package_name }}/business_logic/application.json":
        raise ReleaseVerificationError(
            "The application contract bundle path must identify the packaged contract."
        )
    actual_application = {
        "sha256": _hash(application_path),
        "bytes": _bytes(application_path),
    }
    if _signature(application_record) != _signature(actual_application):
        raise ReleaseVerificationError(
            "The application contract bundle record differs from the packaged contract."
        )
    if _signature(manifest["provenance"]["application"]) != _signature(
        application_record
    ):
        raise ReleaseVerificationError(
            "Application provenance differs from the packaged application contract."
        )

    release_application_records = [
        item["artifact"]
        for item in manifest["artifacts"]
        if item["role"] == "application_contract"
    ]
    if len(release_application_records) != 1 or _signature(
        release_application_records[0]
    ) != _signature(application_record):
        raise ReleaseVerificationError(
            "Release artifacts require the exact packaged application contract."
        )

    for role, provenance_key in (
        ("workflow", "workflows"),
        ("tool_contract", "tools"),
    ):
        released = [
            _signature(item["artifact"])
            for item in manifest["artifacts"]
            if item["role"] == role
        ]
        provenance = [
            _signature(item) for item in manifest["provenance"][provenance_key]
        ]
        if sorted(released) != sorted(provenance):
            raise ReleaseVerificationError(
                f"Released {role} artifacts must equal {provenance_key} provenance."
            )

    policy_records = by_role.get("policy", [])
    weights = [item["artifact"] for item in manifest["policy"]["weights"]]
    if sorted(_signature(item) for item in policy_records) != sorted(
        _signature(item) for item in weights
    ):
        raise ReleaseVerificationError(
            "The policy bundle must match the released policy weights exactly."
        )
    for record in policy_records:
        if not record["path"].startswith("{{ package_name }}/model/"):
            raise ReleaseVerificationError("Policy bundles belong under model/.")

    parser = manifest["policy"]["action_parser"]["artifact"]
    parser_matches = _matching_records(by_role.get("runtime_asset", []), parser)
    if len(parser_matches) != 1:
        raise ReleaseVerificationError(
            "The runtime bundle requires the exact released action parser."
        )
    runtime_policy = manifest["policy"]["runtime"]
    runtime_matches = _matching_records(
        by_role.get("runtime_asset", []), runtime_policy["artifact"]
    )
    if len(runtime_matches) != 1:
        raise ReleaseVerificationError(
            "The runtime bundle requires the exact selected policy adapter."
        )
    module_name, attribute_name = runtime_policy["entrypoint"].split(":", 1)
    if attribute_name == "ScaffoldPolicy" or module_name.endswith(".interface"):
        raise ReleaseVerificationError(
            "The ready release must use the selected policy entrypoint."
        )
    expected_runtime_path = module_name.replace(".", "/") + ".py"
    if runtime_matches[0]["path"] != expected_runtime_path:
        raise ReleaseVerificationError(
            "The selected policy entrypoint differs from its runtime artifact path."
        )

    role_map = {
        "application_contract": "application_contract",
        "workflow": "workflow",
        "tool_contract": "tool_contract",
        "knowledge_base": "knowledge_base",
        "configuration": "configuration",
        "runtime_asset": "runtime_asset",
    }
    claimed = {("application_contract", *_signature(application_record))}
    claimed.update(("policy", *_signature(item)) for item in weights)
    claimed.add(("runtime_asset", *_signature(parser)))
    claimed.add(("runtime_asset", *_signature(runtime_policy["artifact"])))
    for item in manifest["artifacts"]:
        bundle_role = role_map.get(item["role"])
        if bundle_role is None:
            continue
        matches = _matching_records(by_role.get(bundle_role, []), item["artifact"])
        if len(matches) != 1:
            raise ReleaseVerificationError(
                f"The runtime bundle requires the exact released {item['role']} artifact."
            )
        claimed.add((bundle_role, *_signature(item["artifact"])))

    declared = {(record["role"], *_signature(record)) for record in bundle}
    if not claimed.issubset(declared):
        raise ReleaseVerificationError(
            "Every released application artifact must be present in the runtime bundle."
        )
    return manifest
