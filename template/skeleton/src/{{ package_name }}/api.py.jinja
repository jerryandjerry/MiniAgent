"""HTTP API for {{ app_name }}."""

from typing import Any, Dict, List, Optional

from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, Field

from .agent import Agent
from .config import settings
from .model import load_policy
from .release_verifier import ReleaseVerificationError, verify_release


app = FastAPI(title={{ app_name | to_json }}, version="0.1.0")
agent = Agent()


class ChatRequest(BaseModel):
    message: str = Field(min_length=1)
    session_id: Optional[str] = None


class ChatResponse(BaseModel):
    status: str
    message: str
    actions: List[Dict[str, Any]]


@app.get("/health")
def health() -> Dict[str, str]:
    return {"status": "ok"}


@app.get("/ready")
def ready() -> Dict[str, str]:
    try:
        manifest = verify_release()
        load_policy()
    except (ReleaseVerificationError, ImportError, AttributeError, RuntimeError) as exc:
        raise HTTPException(status_code=503, detail=str(exc)) from exc
    return {
        "status": "ready",
        "release_id": str(manifest["release_id"]),
    }


@app.post("/v1/chat", response_model=ChatResponse)
def chat(request: ChatRequest) -> ChatResponse:
    try:
        verify_release()
        response = agent.respond(request.message, request.session_id)
    except (ReleaseVerificationError, ImportError, AttributeError, RuntimeError) as exc:
        raise HTTPException(status_code=503, detail=str(exc)) from exc
    except ValueError as exc:
        raise HTTPException(status_code=422, detail=str(exc)) from exc
    return ChatResponse(
        status=response.status,
        message=response.message,
        actions=response.actions,
    )


def main() -> None:
    import uvicorn

    uvicorn.run(
        "{{ package_name }}.api:app",
        host=settings.host,
        port=settings.port,
        log_level=settings.log_level,
    )
