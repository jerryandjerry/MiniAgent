import hashlib
import json
import shutil
from pathlib import Path

import pytest

from {{ package_name }} import release_verifier


def _artifact(path: str, content: bytes) -> dict:
    return {
        "path": path,
        "sha256": hashlib.sha256(content).hexdigest(),
        "bytes": len(content),
    }


