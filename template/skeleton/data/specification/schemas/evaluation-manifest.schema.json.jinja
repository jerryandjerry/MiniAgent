{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:miniagent:schema:evaluation-manifest:v1",
  "title": "MiniAgent Evaluation Manifest",
  "description": "A reproducible result from a candidate evaluated against a sealed dataset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "application_id",
    "created_at",
    "evaluator",
    "dataset",
    "candidate",
    "protocol",
    "summary",
    "metrics",
    "evidence",
    "reproducibility"
  ],
  "properties": {
    "schema_version": {
      "const": "miniagent.evaluation-manifest.v1"
    },
    "evaluation_id": {
      "$ref": "#/$defs/identifier"
    },
    "application_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source", "config", "launcher_configuration"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/artifact"},
        "config": {"$ref": "#/$defs/artifact"},
        "launcher_configuration": {"$ref": "#/$defs/artifact"}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "path", "sha256", "cases", "sealed"],
      "properties": {
        "dataset_id": {"$ref": "#/$defs/identifier"},
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "cases": {"type": "integer", "minimum": 1},
        "sealed": {"const": true}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "version", "runtime_entrypoint", "artifacts"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/identifier"},
        "version": {"type": "string", "minLength": 1},
        "runtime_entrypoint": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "action_parser", "parameters"],
      "properties": {
        "interface": {"enum": ["api", "cli", "library", "model_server"]},
        "action_parser": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "completed", "errors", "status"],
      "properties": {
        "attempted": {"type": "integer", "minimum": 1},
        "completed": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "status": {"enum": ["passed", "failed"]}
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "aggregation", "direction", "unit"],
        "properties": {
          "name": {"$ref": "#/$defs/identifier"},
          "value": {"type": "number"},
          "aggregation": {"enum": ["mean", "sum", "min", "max", "p50", "p95"]},
          "direction": {"enum": ["maximize", "minimize"]},
          "unit": {"type": "string", "minLength": 1},
          "threshold": {"type": "number"},
          "passed": {"type": "boolean"},
          "slices": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "cases", "value"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "cases": {"type": "integer", "minimum": 1},
                "value": {"type": "number"}
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/artifact"},
          {
            "type": "object",
            "required": ["kind", "format", "cases"],
            "properties": {
              "kind": {"enum": ["transcripts", "scores", "report", "log"]},
              "format": {"enum": ["json", "jsonl"]},
              "cases": {"type": "integer", "minimum": 0}
            }
          }
        ]
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "argv", "source_revision", "environment"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "source_revision": {"type": "string", "minLength": 7},
        "environment": {"$ref": "#/$defs/artifact"}
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0},
        "kind": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "cases": {"type": "integer", "minimum": 0}
      }
    }
  }
}
