# Copy this file to .env in the deployment directory.

# --- Conversation/tool-call backend ------------------------------------------
LLM_TRANSPORT=openai_compat
LLM_MODEL=cn-travel-policy-cee7c1bfa881
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=local

# --- Tool backend -------------------------------------------------------------
# Amap Web Service key for weather, routes, and hotel POIs.
AMAP_KEY=

# --- Hotel prices (optional) --------------------------------------------------
# Amap returned no prices for all 13 tested hotels, and booking-page prices are rendered by JavaScript.
# Direct requests cannot retrieve them, so use a local headless browser with Booking. No key is required.
# Install the browser once before first use: uv run playwright install chromium
# PRICE_BACKEND=playwright

# --- Optional ----------------------------------------------------------------
# REVIEWS_BACKEND=search        # search | claude | dashscope
# SEARCH_RETRIES=3
